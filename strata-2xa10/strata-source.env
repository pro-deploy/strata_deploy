# Where the Strata source in ../strata comes from: an unmodified snapshot of this commit of github.com/Niko1221/Strata.
# The server installs ../strata itself and never downloads Strata; these two lines only record its origin in deploy-info.
# ../strata/third_party/llama.cpp is llama.cpp at the commit setup.py pins (LLAMA_CPP_COMMIT, 3cf0325), unpacked as setup.py
# unpacks it (without tools/ui), so setup does not download it.
# To move to another engine version, replace ../strata with that commit's files and update STRATA_COMMIT.
STRATA_REPO=Niko1221/Strata
STRATA_COMMIT=cbfd5b926b794b356195d3cb600191b0c3567540
